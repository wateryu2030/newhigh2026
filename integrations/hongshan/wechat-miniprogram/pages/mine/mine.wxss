@import '../../styles/tokens.wxss';

.page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.page-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

.open-mode-banner {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(80, 140, 200, 0.1);
  border: 1rpx solid rgba(120, 180, 255, 0.28);
  border-radius: 12rpx;
}
.open-mode-txt {
  font-size: 22rpx;
  color: #a8b4c0;
  line-height: 1.45;
}

.hub-banner {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(60, 120, 200, 0.22), rgba(30, 50, 80, 0.5));
  border: 1rpx solid rgba(120, 180, 255, 0.25);
  position: relative;
}
.hub-tit {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eef4;
  margin-bottom: 8rpx;
}
.hub-sub {
  display: block;
  font-size: 22rpx;
  color: #8a9aac;
  line-height: 1.4;
}
.hub-arr {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.35);
  font-weight: 300;
}

.profile-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(165deg, #1a222c, #141a21);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-ph {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 68, 68, 0.35);
}

.profile-text {
  text-align: center;
  margin-bottom: 28rpx;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.profile-badges {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.badge.guest {
  color: var(--muted);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.badge.soft {
  color: var(--muted);
}

.quota-line {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}

.btn-upgrade {
  margin-top: 16rpx !important;
  font-size: 22rpx !important;
  background: transparent !important;
  color: #ff4444 !important;
  border: 1rpx solid rgba(255, 68, 68, 0.45) !important;
}

.feature-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}
.muted-row {
  opacity: 0.85;
}
.feat {
  flex: 1;
  text-align: center;
  padding: 22rpx 12rpx;
  background: #141a21;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text);
  border: 1rpx solid rgba(255, 68, 68, 0.2);
}
.feat.ghost {
  font-size: 22rpx;
  color: var(--muted);
  border-style: dashed;
}

.btn-wx {
  width: 100% !important;
  line-height: 96rpx !important;
  border-radius: 16rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  background: linear-gradient(90deg, #ff4444, #e02020) !important;
  color: #fff !important;
  border: none !important;
}

.btn-wx[disabled] {
  opacity: 0.45 !important;
}

.btn-wx.outline {
  background: transparent !important;
  border: 2rpx solid rgba(255, 68, 68, 0.5) !important;
  color: #ff8888 !important;
}

.agree-row {
  margin-top: 20rpx;
}

.agree-label {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.5;
}

.net-reset {
  margin-top: 20rpx;
  text-align: center;
}
.net-reset-txt {
  font-size: 22rpx;
  color: #5b8cff;
  text-decoration: underline;
}

.grid-2 {
  margin: 0 24rpx 16rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.grid-big {
  flex: 1;
  min-height: 220rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #141a21;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.grid-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-sm {
  flex: 1;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #141a21;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.grid-sm.half {
  flex: 1;
}

.row2 {
  margin-top: 0;
}

.g-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: rgba(255, 68, 68, 0.2);
  border: 1rpx solid rgba(255, 68, 68, 0.35);
}

.g-chart {
  background: linear-gradient(180deg, rgba(255, 68, 68, 0.35), rgba(255, 68, 68, 0.06));
  position: relative;
}

.g-chart::after {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
}

.g-ico.sm {
  width: 44rpx;
  height: 44rpx;
}

.g-ico.wallet {
  background: rgba(0, 200, 200, 0.12);
  border-color: rgba(0, 200, 200, 0.35);
}

.g-ico.bill {
  background: rgba(0, 192, 135, 0.12);
  border-color: rgba(0, 192, 135, 0.3);
}

.g-ico.bell2 {
  background: rgba(255, 100, 120, 0.15);
}

.g-ico.srv {
  background: rgba(255, 68, 68, 0.12);
}

.g-tit {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.grid-big .g-tit {
  margin-top: 16rpx;
}

.g-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.section-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.section-hint {
  font-size: 22rpx;
  color: #6b7785;
}

.desktop-head {
  padding-bottom: 8rpx;
}

.desktop-menu {
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  background: rgba(10, 15, 20, 0.55);
}

.dm-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.dm-row:last-child {
  border-bottom: none;
}

.dm-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.dm-tag {
  font-size: 20rpx;
  color: #7eb0ff;
  margin-right: 12rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(126, 176, 255, 0.35);
  border-radius: 8rpx;
}

.dm-arr {
  font-size: 32rpx;
  color: #5c6b7a;
}

.section-more {
  font-size: 22rpx;
  color: var(--muted);
}

.report-scroll {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.report-card {
  display: inline-block;
  vertical-align: top;
  width: 420rpx;
  height: 200rpx;
  margin-right: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.report-a {
  background: linear-gradient(135deg, #3a1520 0%, #141a21 100%);
}

.report-b {
  background: linear-gradient(135deg, #152a35 0%, #141a21 100%);
}

.report-tag {
  display: block;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #ff8888;
  margin-bottom: 12rpx;
}

.report-tit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
  white-space: normal;
}

.menu-list {
  margin: 0 24rpx 24rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #141a21;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-ico {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
}

.menu-ico.i-info::after {
  content: 'i';
}

.menu-ico.i-help::after {
  content: '?';
}

.menu-txt {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.menu-arr {
  font-size: 32rpx;
  color: var(--muted);
}

.ver {
  display: block;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: rgba(136, 144, 152, 0.45);
  padding: 16rpx 0 32rpx;
}

.page-bottom-space {
  height: 32rpx;
}
