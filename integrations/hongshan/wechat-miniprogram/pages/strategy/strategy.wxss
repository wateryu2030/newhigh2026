@import '../../styles/tokens.wxss';

.page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.page-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

.guest-tip {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(255, 68, 68, 0.12);
  border: 1rpx solid rgba(255, 68, 68, 0.35);
  border-radius: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.guest-tip.info-tip {
  background: rgba(80, 140, 200, 0.12);
  border: 1rpx solid rgba(120, 180, 255, 0.35);
}

.guest-tip-text {
  flex: 1;
  font-size: 22rpx;
  color: #e5e2e1;
  line-height: 1.45;
}

.guest-tip-btn {
  flex-shrink: 0;
  font-size: 22rpx !important;
  background: #ff4444 !important;
  color: #fff !important;
}

.hero-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #1a222c 0%, #141a21 60%, #121820 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  bottom: -40rpx;
  width: 200rpx;
  height: 120rpx;
  border: 3rpx solid rgba(255, 68, 68, 0.15);
  border-radius: 40% 60% 50% 50%;
  transform: rotate(-12deg);
}

.hero-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #b8a88a;
}

.pill-active {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #0a0f14;
  background: var(--up);
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}

.hero-tags {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-risk {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #ff8888;
  background: rgba(255, 68, 68, 0.12);
  border: 1rpx solid rgba(255, 68, 68, 0.25);
}

.tag-run {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #7dd3c0;
  background: rgba(0, 192, 135, 0.1);
  border: 1rpx solid rgba(0, 192, 135, 0.2);
}

.metrics-grid {
  margin: 0 24rpx 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.metric-cell {
  padding: 24rpx;
  background: #141a21;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.mc-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.mc-val {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.mc-val.up {
  color: var(--up);
}

.mc-val.down {
  color: #ff6b6b;
}

.section-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 28rpx 16rpx;
}

.bar-accent {
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

.section-tit {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.plan-scroll {
  white-space: nowrap;
  padding: 0 24rpx 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.plan-card {
  display: inline-block;
  vertical-align: top;
  width: 420rpx;
  margin-right: 20rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #141a21;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  white-space: normal;
}

.plan-pro {
  background: linear-gradient(165deg, rgba(255, 68, 68, 0.95) 0%, #c42a2a 100%);
  border: 1rpx solid rgba(255, 200, 200, 0.35);
  box-shadow: 0 8rpx 32rpx rgba(255, 68, 68, 0.25);
}

.plan-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.plan-pro .plan-name,
.plan-pro .plan-desc,
.plan-pro .plan-price {
  color: #fff;
}

.plan-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.plan-pro .plan-desc {
  color: rgba(255, 255, 255, 0.85);
}

.plan-price {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.plan-price.pro {
  text-shadow: 0 0 20rpx rgba(0, 0, 0, 0.2);
}

.plan-feat {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.plan-feat text {
  font-size: 22rpx;
  color: var(--muted);
}

.plan-feat .ok::before {
  content: '✓ ';
  color: var(--up);
}

.plan-feat .no::before {
  content: '✕ ';
  color: #666;
}

.plan-feat.light text {
  color: rgba(255, 255, 255, 0.92);
}

.plan-feat.light .ok::before {
  color: #fff;
}

.plan-btn {
  margin-top: 24rpx;
  width: 100%;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx 0;
  line-height: 1.4;
}

.plan-btn.disabled {
  background: rgba(255, 255, 255, 0.08) !important;
  color: var(--muted) !important;
}

.plan-btn.primary {
  background: #0a0f14 !important;
  color: #fff !important;
  font-weight: 600;
}

.plan-btn.ghost {
  background: transparent !important;
  color: var(--text) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.2) !important;
}

.table-scroll {
  margin: 0 24rpx 24rpx;
  width: auto;
}

.cmp-table {
  min-width: 620rpx;
  background: #141a21;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.cmp-row {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.cmp-head {
  background: rgba(255, 255, 255, 0.04);
  font-weight: 600;
}

.cmp-c0 {
  width: 240rpx;
  flex-shrink: 0;
  padding: 20rpx 16rpx;
  font-size: 22rpx;
  color: var(--text);
  box-sizing: border-box;
}

.cmp-c {
  flex: 1;
  padding: 20rpx 16rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

.cmp-c.up {
  color: var(--up);
  font-weight: 600;
}

.cmp-c.ok {
  color: var(--up);
  font-size: 28rpx;
}

.cmp-group {
  padding: 12rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #b8a88a;
  background: rgba(0, 0, 0, 0.2);
}

.locked-box {
  margin: 0 24rpx 24rpx;
  padding: 48rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.35);
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.lock-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--brand);
  border-radius: 10rpx;
  position: relative;
}

.lock-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 20rpx;
  height: 16rpx;
  margin-left: -10rpx;
  border: 4rpx solid var(--brand);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

.lock-txt {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

.cta-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 0 24rpx 32rpx;
  align-items: stretch;
}

.cta-side {
  width: 120rpx;
  padding: 0;
  font-size: 22rpx;
  line-height: 88rpx;
  background: #1e2630 !important;
  color: var(--text) !important;
  border-radius: 14rpx !important;
}

.cta-main {
  flex: 1;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx !important;
  background: linear-gradient(90deg, #ff4444, #e02020) !important;
  color: #0a0f14 !important;
}

.page-bottom-space {
  height: 24rpx;
}
