.wrap {
  padding: 48rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #0a0f14;
  color: #e8ecf0;
}
.brand {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.sub {
  font-size: 26rpx;
  color: #889098;
  display: block;
  margin-bottom: 64rpx;
}
.btn {
  background: #ff4444 !important;
  color: #fff !important;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}
.agree-label {
  font-size: 24rpx;
  color: #889098;
}
.hint {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #5c656e;
  line-height: 1.5;
}
