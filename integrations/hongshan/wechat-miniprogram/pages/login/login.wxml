<view class="wrap">
  <view class="brand">红山量化</view>
  <text class="sub">使用微信账号登录以同步策略、配额与行情权限</text>

  <button class="btn" disabled="{{!agreed}}" loading="{{loading}}" bindtap="onLogin">微信登录</button>

  <checkbox-group class="agree" bindchange="onAgree">
    <label class="agree-label">
      <checkbox value="1" checked="{{agreed}}" color="#FF4444" />
      <text>已阅读并同意《服务协议》与《隐私政策》</text>
    </label>
  </checkbox-group>

  <text class="hint">本平台仅提供数据分析工具，不构成投资建议。市场有风险，投资需谨慎。</text>

  <view class="net-tools">
    <text class="net-link" bindtap="onResetApiBase">网络异常？恢复默认线路</text>
  </view>
</view>
