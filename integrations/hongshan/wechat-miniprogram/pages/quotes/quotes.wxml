<view class="page-root">
  <rh-nav title="行情快照" showSettings="{{false}}" bind:bell="noop" />
  <view class="toolbar">
    <picker mode="selector" range="{{tabLabels}}" value="{{tabIndex}}" bindchange="onTab">
      <text class="tab-pill">{{tabLabels[tabIndex]}}</text>
    </picker>
    <input
      class="search"
      placeholder="搜索代码或名称"
      value="{{keyword}}"
      bindinput="onKw"
      confirm-type="search"
      bindconfirm="onSearch"
    />
  </view>

  <view wx:if="{{loading}}" class="muted pad">加载中…</view>
  <view wx:elif="{{error}}" class="err pad">{{error}}</view>

  <block wx:for="{{displayList}}" wx:key="symbol">
    <view class="row" data-symbol="{{item.symbol}}" bindtap="goDetail">
      <view class="col">
        <text class="name">{{item.name || '—'}}</text>
        <text class="code">{{item.symbol}}</text>
      </view>
      <view class="col ar">
        <text class="price">{{item.priceStr}}</text>
        <text class="pct {{item.chgClass}}">{{item.pctStr}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && displayList.length===0}}" class="muted pad">暂无数据</view>
</view>
