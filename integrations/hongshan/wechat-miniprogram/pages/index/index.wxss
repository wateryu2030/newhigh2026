@import '../../styles/tokens.wxss';

.page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.page-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.guest-tip {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(255, 68, 68, 0.12);
  border: 1rpx solid rgba(255, 68, 68, 0.35);
  border-radius: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.guest-tip-text {
  flex: 1;
  font-size: 22rpx;
  color: #e5e2e1;
  line-height: 1.45;
}

.guest-tip.info-tip {
  background: rgba(80, 140, 200, 0.12);
  border: 1rpx solid rgba(120, 180, 255, 0.35);
}

.guest-tip-btn {
  flex-shrink: 0;
  font-size: 22rpx !important;
  background: #ff4444 !important;
  color: #fff !important;
}

.quick-actions {
  margin: 16rpx 24rpx 0;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.quick-actions.qa-row2 {
  margin-top: 12rpx;
}

.hub-entry {
  margin: 16rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: linear-gradient(125deg, rgba(55, 110, 180, 0.2), rgba(20, 32, 48, 0.65));
  border: 1rpx solid rgba(100, 160, 230, 0.28);
  position: relative;
}
.hub-entry-tit {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e8eef4;
  margin-bottom: 6rpx;
}
.hub-entry-sub {
  display: block;
  font-size: 22rpx;
  color: #8a9aac;
  line-height: 1.35;
  padding-right: 48rpx;
}
.hub-entry-arr {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 38rpx;
  color: rgba(255, 255, 255, 0.3);
}

.qa-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  background: #141a21;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #e8ecf0;
  border: 1rpx solid rgba(255, 68, 68, 0.25);
}

.alert-banner {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(180, 40, 40, 0.35);
  border: 1rpx solid rgba(255, 80, 80, 0.35);
  border-radius: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.alert-ico {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 22rpx;
  color: #f0e8e6;
  line-height: 1.45;
}

.card-metric {
  margin: 24rpx;
  padding: 32rpx;
  background: linear-gradient(145deg, #161d26 0%, #121820 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.35);
}

.metric-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.metric-label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}

.metric-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pill-up {
  background: rgba(0, 192, 135, 0.18);
  color: var(--up);
}

.pill-down {
  background: rgba(255, 68, 68, 0.15);
  color: #ff6b6b;
}

.metric-main {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

.metric-subrow {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
  gap: 32rpx;
}

.metric-sub {
  flex: 1;
}

.sub-label {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.sub-val {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.sub-val.brand {
  color: var(--brand);
}

.sub-val.down {
  color: #ff6b6b;
}

.section-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 28rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.section-link {
  font-size: 22rpx;
  color: var(--muted);
  text-decoration: underline;
}

.tabs {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.tab {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.04);
}

.tab-on {
  color: var(--text);
  background: rgba(255, 255, 255, 0.1);
}

.card-chart {
  margin: 0 24rpx 24rpx;
  padding: 16rpx 16rpx 8rpx;
  background: #141a21;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.equity-canvas {
  width: 100%;
  height: 280rpx;
  display: block;
}

.chart-axis {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.hub-row {
  display: flex;
  flex-direction: row;
  margin: 0 24rpx 24rpx;
  gap: 16rpx;
}

.hub-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #141a21;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.hub-tag {
  display: block;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.hub-cycle {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.hub-desc {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.4;
}

.hub-foot {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--text);
}

.hub-arrow {
  color: var(--muted);
  font-size: 28rpx;
}

.rank-list {
  margin-top: 8rpx;
}

.rank-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.rank-idx {
  width: 32rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.rank-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-pct {
  font-size: 22rpx;
  font-weight: 600;
}

.rank-pct.up {
  color: var(--up);
}

.hub-more {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.signal-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #141a21;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.signal-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.icon-buy {
  background: linear-gradient(135deg, rgba(255, 68, 68, 0.5), rgba(255, 68, 68, 0.2));
  box-shadow: 0 0 12rpx rgba(255, 68, 68, 0.25);
}

.icon-sell {
  background: linear-gradient(135deg, rgba(0, 192, 135, 0.35), rgba(0, 192, 135, 0.1));
}

.icon-hold {
  background: rgba(136, 144, 152, 0.25);
}

.signal-body {
  flex: 1;
  min-width: 0;
}

.signal-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.signal-meta {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.signal-side {
  text-align: right;
}

.signal-dir {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
}

.signal-price {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.muted-box {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.page-bottom-space {
  height: 48rpx;
}
