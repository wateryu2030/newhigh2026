<view class="page-root">
  <rh-nav title="{{titleStr}}" showBell="{{false}}" showSettings="{{false}}" showBack="{{true}}" bind:back="onBack" />
  <view class="pad">
    <text class="muted">代码 {{symbol}} · 日线收盘</text>
  </view>
  <view wx:if="{{loading}}" class="muted pad">加载 K 线…</view>
  <view wx:elif="{{error}}" class="err pad">{{error}}</view>
  <scroll-view wx:else scroll-y class="tbl-wrap">
    <view class="tbl-head row">
      <text class="c1">日期</text>
      <text class="c2 ar">收</text>
      <text class="c3 ar">量</text>
    </view>
    <view class="row" wx:for="{{rows}}" wx:key="d">
      <text class="c1">{{item.d}}</text>
      <text class="c2 ar">{{item.c}}</text>
      <text class="c3 ar">{{item.v}}</text>
    </view>
    <view wx:if="{{rows.length===0}}" class="muted pad">暂无 K 线数据</view>
  </scroll-view>
</view>
